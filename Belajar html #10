<!DOCTYPE html>
<html lang="id">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Table 1 dan Table 2</title>
   <style>
       table {
           border-collapse: collapse;
           width: 50%;
           margin-bottom: 20px;
       }
       table, th, td {
           border: 1px solid black;
       }
       th, td {
           padding: 10px;
           text-align: center;
       }
       th {
           background-color: #4CAF50;
           color: white;
       }
   </style>
</head>
<body>
   <!-- Table 1 -->
   <h3>Table 1</h3>
   <table>
       <tr>
           <th>Kolom 1</th>
           <th>Kolom 2</th>
       </tr>
       <tr>
           <td>Data 1</td>
           <td>Data 2</td>
       </tr>
       <tr>
           <td>Data 3</td>
           <td>Data 4</td>
       </tr>
   </table>
   <!-- Table 2 -->
   <h3>Table 2</h3>
   <table>
       <tr>
           <th>Kolom A</th>
           <th>Kolom B</th>
       </tr>
       <tr>
           <td>Data A1</td>
           <td>Data B1</td>
       </tr>
       <tr>
           <td>Data A2</td>
           <td>Data B2</td>
       </tr>
   </table>
</body>
</html>
